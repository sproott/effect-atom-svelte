{
  "name": "@sproott/effect-atom-svelte",
  "version": "1.0.2",
  "type": "module",
  "description": "Svelte bindings for Effect Atom",
  "license": "MIT",
  "homepage": "https://github.com/sproott/effect-atom-svelte#readme",
  "bugs": {
    "url": "https://github.com/sproott/effect-atom-svelte/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sproott/effect-atom-svelte.git"
  },
  "keywords": [
    "effect",
    "atom",
    "svelte",
    "reactivity"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "svelte": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "prepare": "effect-language-service patch",
    "build": "svelte-package --input src --output dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prelint:package": "pnpm run build",
    "lint:package": "publint",
    "prepublishOnly": "pnpm run lint:package && pnpm run check && pnpm run test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.68"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.1",
    "@sveltejs/package": "^2.4.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "jsdom": "^26.1.0",
    "publint": "^0.3.12",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
